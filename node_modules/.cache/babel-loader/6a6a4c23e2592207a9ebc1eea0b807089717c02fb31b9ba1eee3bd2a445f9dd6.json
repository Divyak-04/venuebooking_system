{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'AdminDashboardPage',\n  data() {\n    return {\n      bookings: [],\n      remarks: {} // Store remarks for each booking\n    };\n  },\n  mounted() {\n    this.fetchBookings();\n  }\n};","map":{"version":3,"names":["axios","name","data","bookings","remarks","mounted","fetchBookings"],"sources":["C:\\Users\\divya\\venue-booking\\src\\components\\AdminDashboardPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"admin-dashboard\">\r\n    <h1>Admin Dashboard - Manage Bookings</h1>\r\n\r\n    <div v-if=\"bookings.length\">\r\n      <h2>Booking Details</h2>\r\n      <table>\r\n        <thead>\r\n          <tr>\r\n            <th>Venue</th>\r\n            <th>Date</th>\r\n            <th>Time</th>\r\n            <th>Purpose</th>\r\n            <th>Status</th>\r\n            <th>Action</th>\r\n            <th>Remark</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"booking in bookings\" :key=\"booking._id\">\r\n            <td>{{ booking.venue }}</td>\r\n            <td>{{ booking.date }}</td>\r\n            <td>{{ booking.time }}</td>\r\n            <td>{{ booking.purpose }}</td>\r\n            <td>{{ booking.status }}</td>\r\n            <td class=\"action-buttons\">\r\n              <button @click=\"approveBooking(booking._id)\" class=\"approve-button\">Approve</button>\r\n              <button @click=\"rejectBooking(booking._id)\" class=\"reject-button\">Reject</button>\r\n            </td>\r\n            <td>\r\n              <input type=\"text\" v-model=\"remarks[booking._id]\" placeholder=\"Enter remark\" />\r\n            </td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n\r\n    <div v-else>\r\n      <p>No bookings found.</p>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'AdminDashboardPage',\r\n  data() {\r\n    return {\r\n      bookings: [],\r\n      remarks: {} // Store remarks for each booking\r\n    };\r\n  },\r\n  \r\n  mounted() {\r\n    this.fetchBookings();\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.admin-dashboard {\r\n  padding: 20px;\r\n}\r\n\r\ntable {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n}\r\n\r\ntable,\r\nth,\r\ntd {\r\n  border: 1px solid #ccc;\r\n}\r\n\r\nth,\r\ntd {\r\n  padding: 10px;\r\n  text-align: left;\r\n}\r\n\r\n.action-buttons {\r\n  display: flex;\r\n  gap: 10px; /* Adds space between buttons */\r\n}\r\n\r\n.approve-button,\r\n.reject-button {\r\n  padding: 8px 12px; /* Adds padding for better button size */\r\n  border: none;\r\n  border-radius: 4px; /* Rounds the corners */\r\n  cursor: pointer;\r\n  color: #fff; /* White text color */\r\n  font-weight: bold; /* Bold font */\r\n  transition: background-color 0.3s; /* Smooth transition for hover effect */\r\n}\r\n\r\n.approve-button {\r\n  background-color: #4CAF50; /* Green color for approve */\r\n}\r\n\r\n.approve-button:hover {\r\n  background-color: #45a049; /* Darker green on hover */\r\n}\r\n\r\n.reject-button {\r\n  background-color: #f44336; /* Red color for reject */\r\n}\r\n\r\n.reject-button:hover {\r\n  background-color: #d32f2f; /* Darker red on hover */\r\n}\r\n\r\ninput {\r\n  width: 150px;\r\n}\r\n</style>\r\n"],"mappings":"AA4CA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,oBAAoB;EAC1BC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,OAAO,EAAE,CAAC,EAAE;IACd,CAAC;EACH,CAAC;EAEDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,aAAa,CAAC,CAAC;EACtB;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}