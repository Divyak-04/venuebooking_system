assword:</label>\r\n        <input type=\"password\" v-model=\"password\" required />\r\n      </div>\r\n      <button type=\"submit\">Login</button>\r\n    </form>\r\n\r\n    <p v-if=\"errorMessage\" class=\"error\">{{ errorMessage }}</p>\r\n    <p v-if=\"successMessage\" class=\"success\">{{ successMessage }}</p>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      email: '',\r\n      password: '',\r\n      role: '',\r\n      errorMessage: '',\r\n      successMessage: '',\r\n    };\r\n  },\r\n  methods: {\r\n    async login() {\r\n      try {\r\n        const response = await axios.post('http://localhost:3000/login', {\r\n          email: this.email,\r\n          password: this.password,\r\n          role: this.role,\r\n        });\r\n\r\n        if (response.data.success) {\r\n          this.successMessage = response.data.message;\r\n          this.errorMessage = '';\r\n          this.$router.push('/'); // Redirect to home page\r\n        } else {\r\n          this.errorMessage = response.data.message;\r\n          this.successMessage = '';\r\n        }\r\n      } catch (error) {\r\n        this.errorMessage = 'An error occurred. Please try again.';\r\n        this.successMessage = '';\r\n        console.error('Error during login:', error);\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n\r\n\r\n<style>\r\n.login-container {\r\n  max-width: 400px; /* Maximum width for the login form */\r\n  margin: auto; /* Center the form horizontally */\r\n  padding: 20px; /* Padding inside the form */\r\n  background-color: #f9f9f9; /* Light background color */\r\n  border-radius: 8px; /* Rounded corners */\r\n  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1); /* Subtle shadow for depth */\r\n  font-family: 'Arial', sans-serif; /* Font style */\r\n  transition: all 0.3s ease; /* Smooth transition */\r\n}\r\n\r\n.login-container:hover {\r\n  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2); /* Shadow on hover */\r\n}\r\n\r\nh2 {\r\n  text-align: center; /* Center the heading */\r\n  margin-bottom: 20px; /* Space below heading */\r\n  color: #3498db; /* Heading color */\r\n}\r\n\r\ndiv {\r\n  margin-bottom: 15px; /* Space between input groups */\r\n}\r\n\r\nlabel {\r\n  display: block; /* Labels on their own line */\r\n  margin-bottom: 5px; /* Space below labels */\r\n  color: #333; /* Label color */\r\n}\r\n\r\ninput[type=\"email\"], input[type=\"password\"], select {\r\n  width: 100%; /* Full width for inputs and select */\r\n  padding: 12px; /* Padding inside inputs */\r\n  border-radius: 4px; /* Rounded corners */\r\n  border: 1px solid #ddd; /* Light border */\r\n  font-size: 14px; /* Font size */\r\n  transition: border-color 0.3s; /* Transition for border color */\r\n}\r\n\r\ninput[type=\"email\"]:focus, input[type=\"password\"]:focus, select:focus {\r\n  border-color: #3498db; /* Change border color on focus */\r\n  outline: none; /* Remove default outline */\r\n}\r\n\r\nbutton {\r\n  padding: 12px; /* Padding inside button */\r\n  border: none; /* No border */\r\n  background-color: #3498db; /* Button background color */\r\n  color: #fff; /* Button text color */\r\n  border-radius: 4px; /* Rounded corners */\r\n  cursor: pointer; /* Pointer cursor on hover */\r\n  font-size: 16px; /* Font size */\r\n  transition: background-color 0.3s; /* Transition for background color */\r\n  width: 100%; /* Full width button */\r\n}\r\n\r\nbutton:hover {\r\n  background-color: #2980b9; /* Darker shade on hover */\r\n}\r\n\r\np {\r\n  text-align: center; /* Center the text */\r\n  font-size: 14px; /* Font size */\r\n}\r\n\r\np.error {\r\n  color: red; /* Error message color */\r\n}\r\n\r\np.success {\r\n  color: green; /* Success message color */\r\n}\r\n\r\n</style>\r\n"],"mappings":";;EACOA,KAAK,EAAC;AAAiB;;EAD9BC,GAAA;EAuB2BD,KAAK,EAAC;;;EAvBjCC,GAAA;EAwB6BD,KAAK,EAAC;;;uBAvBjCE,mBAAA,CAwBM,OAxBNC,UAwBM,G,0BAvBJC,mBAAA,CAAc,YAAV,OAAK,sBACTA,mBAAA,CAkBO;IAlBAC,QAAM,EA