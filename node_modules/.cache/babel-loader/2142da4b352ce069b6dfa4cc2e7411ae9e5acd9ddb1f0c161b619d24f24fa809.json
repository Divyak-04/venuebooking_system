{"ast":null,"code":"export default {\n  data() {\n    return {\n      email: \"\",\n      password: \"\",\n      message: \"\"\n    };\n  },\n  methods: {\n    handleLogin() {\n      // Call backend to validate user\n      fetch(\"http://localhost:3000/login\", {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\"\n        },\n        body: JSON.stringify({\n          email: this.email,\n          password: this.password\n        })\n      }).then(res => res.json()).then(data => {\n        if (data.success) {\n          this.message = \"Login successful!\";\n        } else {\n          this.message = \"Invalid credentials!\";\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["data","email","password","message","methods","handleLogin","fetch","method","headers","body","JSON","stringify","then","res","json","success"],"sources":["C:\\Users\\divya\\venue-booking\\src\\components\\Login.vue"],"sourcesContent":["<template>\r\n    <div>\r\n      <h1>Login</h1>\r\n      <form @submit.prevent=\"handleLogin\">\r\n        <label for=\"email\">Email:</label>\r\n        <input v-model=\"email\" type=\"email\" id=\"email\" required />\r\n        \r\n        <label for=\"password\">Password:</label>\r\n        <input v-model=\"password\" type=\"password\" id=\"password\" required />\r\n  \r\n        <button type=\"submit\">Login</button>\r\n      </form>\r\n      <p>{{ message }}</p>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  export default {\r\n    data() {\r\n      return {\r\n        email: \"\",\r\n        password: \"\",\r\n        message: \"\",\r\n      };\r\n    },\r\n    methods: {\r\n      handleLogin() {\r\n        // Call backend to validate user\r\n        fetch(\"http://localhost:3000/login\", {\r\n          method: \"POST\",\r\n          headers: { \"Content-Type\": \"application/json\" },\r\n          body: JSON.stringify({ email: this.email, password: this.password }),\r\n        })\r\n   