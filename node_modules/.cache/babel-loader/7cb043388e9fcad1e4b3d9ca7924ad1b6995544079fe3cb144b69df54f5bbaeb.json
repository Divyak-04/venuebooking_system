{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  data() {\n    return {\n      email: '',\n      password: '',\n      role: '',\n      errorMessage: '',\n      successMessage: ''\n    };\n  },\n  methods: {\n    async login() {\n      try {\n        const response = await axios.post('http://localhost:3000/login', {\n          email: this.email,\n          password: this.password,\n          role: this.role\n        });\n        if (response.data.success) {\n          const user = response.data.user; // Assuming the response contains user data\n          // Store user details in localStorage\n          localStorage.setItem('user', JSON.stringify({\n            _id: user._id,\n            email: user.email,\n            role: user.role // Optional: store role if needed\n          }));\n          this.successMessage = response.data.message;\n          this.errorMessage = '';\n          this.$router.push('/'); // Redirect to home page\n        } else {\n          this.errorMessage = response.data.message;\n          this.successMessage = '';\n        }\n      } catch (error) {\n        this.errorMessage = error.response?.data?.message || 'An error occurred. Please try again.';\n        this.successMessage = '';\n        console.error('Error during login:', error.response ? error.response.data : error);\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","data","email","password","role","errorMessage","successMessage","methods","login","response","post","success","user","localStorage","setItem","JSON","stringify","_id","message","$router","push","error","console"],"sources":["C:\\Users\\divya\\venue-booking\\src\\components\\UserLogin.vue"],"sourcesContent":["<template>\r\n  <div class=\"login-container\">\r\n    <h2>Login</h2>\r\n    <img src=\"../components/logologo-removebg-preview.png\" alt=\"College Logo\" class=\"logo\" />\r\n\r\n    <form @submit.prevent=\"login\">\r\n      <div>\r\n        <label for=\"role\">Role:</label>\r\n        <select v-model=\"role\" required>\r\n          <option value=\"\" disabled>Select Role</option>\r\n          <option value=\"faculty\">Faculty</option>\r\n          <option value=\"admin\">Admin</option>\r\n        </select>\r\n      </div>\r\n      <div>\r\n        <label for=\"email\">Email:</label>\r\n        <input type=\"email\" v-model=\"email\" required />\r\n      </div>\r\n      <div>\r\n        <label for=\"password\">Password:</label>\r\n        <input type=\"password\" v-model=\"password\" required />\r\n      </div>\r\n      <button type=\"submit\">Login</button>\r\n    </form>\r\n\r\n    <p v-if=\"errorMessage\" class=\"error\">{{ errorMessage }}</p>\r\n    <p v-if=\"successMessage\" class=\"success\">{{ successMessage }}</p>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      email: '',\r\n      password: '',\r\n      role: '',\r\n      errorMessage: '',\r\n      successMessage: '',\r\n    };\r\n  },\r\n  methods: {\r\n    async login() {\r\n      try {\r\n        const response = await axios.post('http://localhost:3000/login', {\r\n  email: this.email,\r\n  password: this.password,\r\n  role: this.role,\r\n\r\n\r\n        });\r\n\r\n        if (response.data.success) {\r\n          const user = response.data.user; // Assuming the response contains user data\r\n          // Store user details in localStorage\r\n          localStorage.setItem('user', JSON.stringify({\r\n            _id: user._id,\r\n            email: user.email,\r\n            role: user.role, // Optional: store role if needed\r\n          }));\r\n\r\n          this.successMessage = response.data.message;\r\n          this.errorMessage = '';\r\n          this.$router.push('/'); // Redirect to home page\r\n        } else {\r\n          this.errorMessage = response.data.message;\r\n          this.successMessage = '';\r\n        }\r\n      } catch (error) {\r\n  this.errorMessage = error.response?.data?.message || 'An error occurred. Please try again.';\r\n  this.successMessage = '';\r\n  console.error('Error during login:', error.response ? error.response.data : error);\r\n}\r\n\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style>\r\n.login-container {\r\n  max-width: 400px; /* Maximum width for the login form */\r\n  margin: auto; /* Center the form horizontally */\r\n  padding: 20px; /* Padding inside the form */\r\n  background-color: #f9f9f9; /* Light background color */\r\n  border-radius: 8px; /* Rounded corners */\r\n  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1); /* Subtle shadow for depth */\r\n  font-family: 'Arial', sans-serif; /* Font style */\r\n  transition: all 0.3s ease; /* Smooth transition */\r\n}\r\n\r\n.login-container:hover {\r\n  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2); /* Shadow on hover */\r\n}\r\n\r\nh2 {\r\n  text-align: center; /* Center the heading */\r\n  margin-bottom: 20px; /* Space below heading */\r\n  color: #3498db; /* Heading color */\r\n}\r\n\r\ndiv {\r\n  margin-bottom: 15px; /* Space between input groups */\r\n}\r\n\r\nlabel {\r\n  display: block; /* Labels on their own line */\r\n  margin-bottom: 5px; /* Space below labels */\r\n  color: #333; /* Label color */\r\n}\r\n\r\ninput[type=\"email\"], input[type=\"password\"], select {\r\n  width: 100%; /* Full width for inputs and select */\r\n  padding: 12px; /* Padding inside inputs */\r\n  border-radius: 4px; /* Rounded corners */\r\n  border: 1px solid #ddd; /* Light border */\r\n  font-size: 14px; /* Font size */\r\n  transition: border-color 0.3s; /* Transition for border color */\r\n}\r\n\r\ninput[type=\"email\"]:focus, input[type=\"password\"]:focus, select:focus {\r\n  border-color: #3498db; /* Change border color on focus */\r\n  outline: none; /* Remove default outline */\r\n}\r\n\r\nbutton {\r\n  padding: 12px; /* Padding inside button */\r\n  border: none; /* No border */\r\n  background-color: #3498db; /* Button background color */\r\n  color: #fff; /* Button text color */\r\n  border-radius: 4px; /* Rounded corners */\r\n  cursor: pointer; /* Pointer cursor on hover */\r\n  font-size: 16px; /* Font size */\r\n  transition: background-color 0.3s; /* Transition for background color */\r\n  width: 100%; /* Full width button */\r\n}\r\n\r\nbutton:hover {\r\n  background-color: #2980b9; /* Darker shade on hover */\r\n}\r\n\r\np {\r\n  text-align: center; /* Center the text */\r\n  font-size: 14px; /* Font size */\r\n}\r\n\r\np.error {\r\n  color: red; /* Error message color */\r\n}\r\n\r\np.success {\r\n  color: green; /* Success message color */\r\n}\r\n</style>\r\n"],"mappings":";AA+BA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,IAAI,EAAE,EAAE;MACRC,YAAY,EAAE,EAAE;MAChBC,cAAc,EAAE;IAClB,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,KAAKA,CAAA,EAAG;MACZ,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMT,KAAK,CAACU,IAAI,CAAC,6BAA6B,EAAE;UACvER,KAAK,EAAE,IAAI,CAACA,KAAK;UACjBC,QAAQ,EAAE,IAAI,CAACA,QAAQ;UACvBC,IAAI,EAAE,IAAI,CAACA;QAGL,CAAC,CAAC;QAEF,IAAIK,QAAQ,CAACR,IAAI,CAACU,OAAO,EAAE;UACzB,MAAMC,IAAG,GAAIH,QAAQ,CAACR,IAAI,CAACW,IAAI,EAAE;UACjC;UACAC,YAAY,CAACC,OAAO,CAAC,MAAM,EAAEC,IAAI,CAACC,SAAS,CAAC;YAC1CC,GAAG,EAAEL,IAAI,CAACK,GAAG;YACbf,KAAK,EAAEU,IAAI,CAACV,KAAK;YACjBE,IAAI,EAAEQ,IAAI,CAACR,IAAI,CAAE;UACnB,CAAC,CAAC,CAAC;UAEH,IAAI,CAACE,cAAa,GAAIG,QAAQ,CAACR,IAAI,CAACiB,OAAO;UAC3C,IAAI,CAACb,YAAW,GAAI,EAAE;UACtB,IAAI,CAACc,OAAO,CAACC,IAAI,CAAC,GAAG,CAAC,EAAE;QAC1B,OAAO;UACL,IAAI,CAACf,YAAW,GAAII,QAAQ,CAACR,IAAI,CAACiB,OAAO;UACzC,IAAI,CAACZ,cAAa,GAAI,EAAE;QAC1B;MACF,EAAE,OAAOe,KAAK,EAAE;QACpB,IAAI,CAAChB,YAAW,GAAIgB,KAAK,CAACZ,QAAQ,EAAER,IAAI,EAAEiB,OAAM,IAAK,sCAAsC;QAC3F,IAAI,CAACZ,cAAa,GAAI,EAAE;QACxBgB,OAAO,CAACD,KAAK,CAAC,qBAAqB,EAAEA,KAAK,CAACZ,QAAO,GAAIY,KAAK,CAACZ,QAAQ,CAACR,IAAG,GAAIoB,KAAK,CAAC;MACpF;IAEI;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}