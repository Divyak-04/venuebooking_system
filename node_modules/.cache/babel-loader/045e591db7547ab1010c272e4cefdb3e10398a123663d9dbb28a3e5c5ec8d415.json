{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'DashboardPage',\n  data() {\n    return {\n      bookings: [],\n      facultyId: 'YOUR_FACULTY_ID' // Replace this with actual faculty ID\n    };\n  },\n  methods: {\n    async fetchBookings() {\n      try {\n        // Fetch bookings for this particular faculty using their faculty ID\n        const response = await axios.get(`http://localhost:3002/bookings?facultyId=${this.facultyId}`);\n        this.bookings = response.data;\n      } catch (error) {\n        console.error(\"Error fetching bookings:\", error);\n      }\n    }\n  },\n  mounted() {\n    this.fetchBookings();\n  }\n};","map":{"version":3,"names":["axios","name","data","bookings","facultyId","methods","fetchBookings","response","get","error","console","mounted"],"sources":["C:\\Users\\divya\\venue-booking\\src\\components\\DashboardPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"dashboard\">\r\n    <h1>Faculty Dashboard - Your Bookings</h1>\r\n    \r\n    <div v-if=\"bookings.length\">\r\n      <h2>Your Booking Details</h2>\r\n      <table>\r\n        <thead>\r\n          <tr>\r\n            <th>Venue</th>\r\n            <th>Date</th>\r\n            <th>Status</th>\r\n            <th>Remark (If Rejected)</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"booking in bookings\" :key=\"booking._id\">\r\n            <td>{{ booking.venue }}</td>\r\n            <td>{{ booking.date }}</td>\r\n            <td>{{ booking.status }}</td>\r\n            <td v-if=\"booking.status === 'Rejected'\">{{ booking.remark }}</td>\r\n            <td v-else>N/A</td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n    \r\n    <div v-else>\r\n      <p>No bookings found.</p>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'DashboardPage',\r\n  data() {\r\n    return {\r\n      bookings: [],\r\n      facultyId: 'YOUR_FACULTY_ID', // Replace this with actual faculty ID\r\n    };\r\n  },\r\n  methods: {\r\n    async fetchBookings() {\r\n      try {\r\n        // Fetch bookings for this particular faculty using their faculty ID\r\n        const response = await axios.get(`http://localhost:3002/bookings?facultyId=${this.facultyId}`);\r\n        this.bookings = response.data;\r\n      } catch (error) {\r\n        console.error(\"Error fetching bookings:\", error);\r\n      }\r\n    }\r\n  },\r\n  mounted() {\r\n    this.fetchBookings();\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.dashboard {\r\n  padding: 20px;\r\n}\r\ntable {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n}\r\ntable, th, td {\r\n  border: 1px solid #ccc;\r\n}\r\nth, td {\r\n  padding: 10px;\r\n  text-align: left;\r\n}\r\n</style>\r\n"],"mappings":"AAkCA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,eAAe;EACrBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,SAAS,EAAE,iBAAiB,CAAE;IAChC,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,aAAaA,CAAA,EAAG;MACpB,IAAI;QACF;QACA,MAAMC,QAAO,GAAI,MAAMP,KAAK,CAACQ,GAAG,CAAC,4CAA4C,IAAI,CAACJ,SAAS,EAAE,CAAC;QAC9F,IAAI,CAACD,QAAO,GAAII,QAAQ,CAACL,IAAI;MAC/B,EAAE,OAAOO,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,0BAA0B,EAAEA,KAAK,CAAC;MAClD;IACF;EACF,CAAC;EACDE,OAAOA,CAAA,EAAG;IACR,IAAI,CAACL,aAAa,CAAC,CAAC;EACtB;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}