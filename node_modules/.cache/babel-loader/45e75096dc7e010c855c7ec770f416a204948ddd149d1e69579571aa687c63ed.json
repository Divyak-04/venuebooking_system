{"ast":null,"code":"import axios from 'axios';\nimport eventBus from '../eventBus'; // Import event bus\n\nexport default {\n  name: 'AdminDashboardPage',\n  data() {\n    return {\n      bookings: [],\n      remarks: {} // Store remarks for each booking\n    };\n  },\n  methods: {\n    async fetchBookings() {\n      try {\n        const response = await axios.get(`http://localhost:3002/bookings`);\n        this.bookings = response.data;\n      } catch (error) {\n        console.error(\"Error fetching bookings:\", error);\n      }\n    },\n    async approveBooking(bookingId) {\n      try {\n        await axios.patch(`http://localhost:3002/bookings/${bookingId}`, {\n          status: 'Approved'\n        });\n        this.fetchBookings(); // Refresh bookings after approval\n        eventBus.$emit('booking-updated'); // Emit an event on booking update\n      } catch (error) {\n        console.error(\"Error approving booking:\", error);\n      }\n    },\n    async rejectBooking(bookingId) {\n      try {\n        const remark = this.remarks[bookingId] || 'No remark provided';\n        await axios.patch(`http://localhost:3002/bookings/${bookingId}`, {\n          status: 'Rejected',\n          remark\n        });\n        this.fetchBookings(); // Refresh bookings after rejection\n        eventBus.$emit('booking-updated'); // Emit an event on booking update\n      } catch (error) {\n        console.error(\"Error rejecting booking:\", error);\n      }\n    }\n  },\n  mounted() {\n    this.fetchBookings();\n  }\n};","map":{"version":3,"names":["axios","eventBus","name","data","bookings","remarks","methods","fetchBookings","response","get","error","console","approveBooking","bookingId","patch","status","$emit","rejectBooking","remark","mounted"],"sources":["C:\\Users\\divya\\venue-booking\\src\\components\\AdminDashboardPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"admin-dashboard\">\r\n    <h1>Admin Dashboard - Manage Bookings</h1>\r\n\r\n    <div v-if=\"bookings.length\">\r\n      <h2>Booking Details</h2>\r\n      <table>\r\n        <thead>\r\n          <tr>\r\n            <th>Venue</th>\r\n            <th>Date</th>\r\n            <th>Time</th>\r\n            <th>Purpose</th>\r\n            <th>Status</th>\r\n            <th>Action</th>\r\n            <th>Remark</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"booking in bookings\" :key=\"booking._id\">\r\n            <td>{{ booking.venue }}</td>\r\n            <td>{{ booking.date }}</td>\r\n            <td>{{ booking.time }}</td>\r\n            <td>{{ booking.purpose }}</td>\r\n            <td>{{ booking.status }}</td>\r\n            <td class=\"action-buttons\">\r\n              <button @click=\"approveBooking(booking._id)\" class=\"approve-button\">Approve</button>\r\n              <button @click=\"rejectBooking(booking._id)\" class=\"reject-button\">Reject</button>\r\n            </td>\r\n            <td>\r\n              <input type=\"text\" v-model=\"remarks[booking._id]\" placeholder=\"Enter remark\" />\r\n            </td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n\r\n    <div v-else>\r\n      <p>No bookings found.</p>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\nimport eventBus from '../eventBus'; // Import event bus\r\n\r\nexport default {\r\n  name: 'AdminDashboardPage',\r\n  data() {\r\n    return {\r\n      bookings: [],\r\n      remarks: {} // Store remarks for each booking\r\n    };\r\n  },\r\n  methods: {\r\n    async fetchBookings() {\r\n      try {\r\n        const response = await axios.get(`http://localhost:3002/bookings`);\r\n        this.bookings = response.data;\r\n      } catch (error) {\r\n        console.error(\"Error fetching bookings:\", error);\r\n      }\r\n    },\r\n    async approveBooking(bookingId) {\r\n      try {\r\n        await axios.patch(`http://localhost:3002/bookings/${bookingId}`, { status: 'Approved' });\r\n        this.fetchBookings(); // Refresh bookings after approval\r\n        eventBus.$emit('booking-updated'); // Emit an event on booking update\r\n      } catch (error) {\r\n        console.error(\"Error approving booking:\", error);\r\n      }\r\n    },\r\n    async rejectBooking(bookingId) {\r\n      try {\r\n        const remark = this.remarks[bookingId] || 'No remark provided';\r\n        await axios.patch(`http://localhost:3002/bookings/${bookingId}`, { status: 'Rejected', remark });\r\n        this.fetchBookings(); // Refresh bookings after rejection\r\n        eventBus.$emit('booking-updated'); // Emit an event on booking update\r\n      } catch (error) {\r\n        console.error(\"Error rejecting booking:\", error);\r\n      }\r\n    }\r\n  },\r\n  mounted() {\r\n    this.fetchBookings();\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.admin-dashboard {\r\n  padding: 20px;\r\n}\r\ntable {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n}\r\ntable, th, td {\r\n  border: 1px solid #ccc;\r\n}\r\nth, td {\r\n  padding: 10px;\r\n  text-align: left;\r\n}\r\n.action-buttons {\r\n  display: flex;\r\n  gap: 10px;\r\n}\r\n.approve-button,\r\n.reject-button {\r\n  padding: 8px 12px;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n  color: #fff;\r\n  font-weight: bold;\r\n  transition: background-color 0.3s;\r\n}\r\n.approve-button {\r\n  background-color: #4CAF50;\r\n}\r\n.approve-button:hover {\r\n  background-color: #45a049;\r\n}\r\n.reject-button {\r\n  background-color: #f44336;\r\n}\r\n.reject-button:hover {\r\n  background-color: #d32f2f;\r\n}\r\ninput {\r\n  width: 150px;\r\n}\r\n</style>\r\n"],"mappings":"AA4CA,OAAOA,KAAI,MAAO,OAAO;AACzB,OAAOC,QAAO,MAAO,aAAa,EAAE;;AAEpC,eAAe;EACbC,IAAI,EAAE,oBAAoB;EAC1BC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,OAAO,EAAE,CAAC,EAAE;IACd,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,aAAaA,CAAA,EAAG;MACpB,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMR,KAAK,CAACS,GAAG,CAAC,gCAAgC,CAAC;QAClE,IAAI,CAACL,QAAO,GAAII,QA