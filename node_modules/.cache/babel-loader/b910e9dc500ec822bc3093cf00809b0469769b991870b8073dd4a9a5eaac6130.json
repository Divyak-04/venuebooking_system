{"ast":null,"code":"import axios from 'axios';\nexport default {\n  data() {\n    return {\n      bookings: []\n    };\n  },\n  created() {\n    this.fetchBookings();\n  },\n  methods: {\n    fetchBookings() {\n      const userEmail = this.getFacultyEmail(); // Function to get the logged-in faculty's email\n\n      axios.get(`http://localhost:3000/bookings/faculty/${userEmail}`).then(response => {\n        this.bookings = response.data;\n      }).catch(error => {\n        console.error('There was an error fetching bookings!', error);\n      });\n    },\n    getFacultyEmail() {\n      const user = JSON.parse(localStorage.getItem('user'));\n      return user ? user.email : null;\n    }\n  }\n};","map":{"version":3,"names":["axios","data","bookings","created","fetchBookings","methods","userEmail","getFacultyEmail","get","then","response","catch","error","console","user","JSON","parse","localStorage","getItem","email"],"sources":["C:\\Users\\divya\\venue-booking\\src\\components\\DashboardPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"dashboard-container\">\r\n    <h1>Your Bookings</h1>\r\n    <table>\r\n      <thead>\r\n        <tr>\r\n          <th>Venue</th>\r\n          <th>Date</th>\r\n          <th>Time</th>\r\n          <th>Purpose</th>\r\n          <th>Status</th>\r\n          <th>Admin Remark</th>\r\n        </tr>\r\n      </thead>\r\n      <tbody>\r\n        <tr v-for=\"booking in bookings\" :key=\"booking._id\">\r\n          <td>{{ booking.venue }}</td>\r\n          <td>{{ booking.date }}</td>\r\n          <td>{{ booking.time }}</td>\r\n          <td>{{ booking.purpose }}</td>\r\n          <td>{{ booking.status }}</td>\r\n          <td>{{ booking.remark || 'N/A' }}</td>\r\n        </tr>\r\n      </tbody>\r\n    </table>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      bookings: []\r\n    };\r\n  },\r\n  created() {\r\n    this.fetchBookings();\r\n  },\r\n  methods: {\r\n    fetchBookings() {\r\n      const userEmail = this.getFacultyEmail(); // Function to get the logged-in faculty's email\r\n\r\n      axios.get(`http://localhost:3000/bookings/faculty/${userEmail}`)\r\n        .then(response => {\r\n          this.bookings = response.data;\r\n        })\r\n        .catch(error => {\r\n          console.error('There was an error fetching bookings!', error);\r\n        });\r\n    },\r\n    getFacultyEmail() {\r\n      const user = JSON.parse(localStorage.getItem('user'));\r\n      return user ? user.email : null;\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.dashboard-container {\r\n  max-width: 800px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n  font-family: 'Roboto', sans-serif;\r\n}\r\n\r\nh1 {\r\n  text-align: center;\r\n  font-size: 2rem;\r\n  margin-bottom: 20px;\r\n}\r\n\r\ntable {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n}\r\n\r\nth, td {\r\n  padding: 12px;\r\n  text-align: left;\r\n  border-bottom: 1px solid #ddd;\r\n}\r\n\r\nth {\r\n  background-color: #007bff;\r\n  color: white;\r\n}\r\n\r\ntr:hover {\r\n  background-color: #f1f1f1;\r\n}\r\n</style>\r\n"],"mappings":"AA6BA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE;IACZ,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,aAAa,CAAC,CAAC;EACtB,CAAC;EACDC,OAAO,EAAE;IACPD,aAAaA,CAAA,EAAG;MACd,MAAME,SAAQ,GAAI,IAAI,CAACC,eAAe,CAAC,CAAC,EAAE;;MAE1CP,KAAK,CAACQ,GAAG,CAAC,0CAA0CF,SAAS,EAAE,EAC5DG,IAAI,CAACC,QAAO,IAAK;QAChB,IAAI,CAACR,QAAO,GAAIQ,QAAQ,CAACT,IAAI;MAC/B,CAAC,EACAU,KAAK,CAACC,KAAI,IAAK;QACdC,OAAO,CAACD,KAAK,CAAC,uCAAuC,EAAEA,KAAK,CAAC;MAC/D,CAAC,CAAC;IACN,CAAC;IACDL,eAAeA,CAAA,EAAG;MAChB,MAAMO,IAAG,GAAIC,IAAI,CAACC,KAAK,CAACC,YAAY,CAACC,OAAO,CAAC,MAAM,CAAC,CAAC;MACrD,OAAOJ,IAAG,GAAIA,IAAI,CAACK,KAAI,GAAI,IAAI;IACjC;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}