{"ast":null,"code":"export default {\n  name: 'SuccessPage'\n};","map":{"version":3,"names":["name"],"sources":["C:\\Users\\divya\\venue-booking\\src\\components\\SuccessPage.vue"],"sourcesContent":["<template>\r\n    <div class=\"success-container\">\r\n      <div class=\"success-message\">\r\n        <i class=\"fas fa-check-circle\"></i>\r\n        <h1>Your Booking Has Been Done!</h1>\r\n        <p>Please wait for the approval.</p>\r\n        <router-link to=\"/\" class=\"btn-ok\">OK</router-link>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  export default {\r\n    name: 'SuccessPage',\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .success-container {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    height: 100vh;\r\n    background-color: #f0f8ff;\r\n    font-family: 'Roboto', sans-serif;\r\n  }\r\n  \r\n  .success-message {\r\n    text-align: center;\r\n    background-color: white;\r\n    padding: 40px;\r\n    border-radius: 12px;\r\n    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);\r\n    max-width: 400px;\r\n  }\r\n  \r\n  .success-message i {\r\n    font-size: 60px;\r\n    color: #4caf50;\r\n    margin-bottom: 20px;\r\n  }\r\n  \r\n  h1 {\r\n    font-size: 2rem;\r\n    margin-bottom: 10px;\r\n    color: #333;\r\n  }\r\n  \r\n  p {\r\n    font-size: 1rem;\r\n    margin-bottom: 20px;\r\n    color: #555;\r\n  }\r\n  \r\n  .btn-ok {\r\n    display: inline-block;\r\n    padding: 12px 24px;\r\n    background-color: #007bff;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 6px;\r\n    text-decoration: none;\r\n    font-size: 1rem;\r\n    transition: background-color 0.3s ease;\r\n  }\r\n  \r\n  .btn-ok:hover {\r\n    background-color: #0056b3;\r\n  }\r\n  </style>\r\n  \r\n  "],"mappings":"AAYE,eAAe;EACbA,IAAI,EAAE;AACR,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}