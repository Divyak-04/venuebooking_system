{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from \"axios\";\nexport default {\n  name: \"UserLogin\",\n  data() {\n    return {\n      email: \"\",\n      password: \"\"\n    };\n  },\n  methods: {\n    async loginUser() {\n      try {\n        const response = await axios.post(\"http://localhost:3000/login\", {\n          email: this.email,\n          password: this.password\n        });\n        if (response.data.success) {\n          // Successful login, redirect to homepage\n          alert(\"Login successful! Redirecting to homepage...\");\n          this.$router.push(\"/homepage\");\n        } else if (response.data.message === \"User not found\") {\n          alert(\"User not found. Please register first.\");\n          this.$router.push(\"/register\");\n        } else {\n          alert(\"Invalid credentials, please try again.\");\n        }\n      } catch (error) {\n        alert(\"An error occurred. Please try again later.\");\n        console.error(error);\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","email","password","methods","loginUser","response","post","success","alert","$router","push","message","error","console"],"sources":["C:\\Users\\divya\\venue-booking\\src\\components\\UserLogin.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <h2>Login</h2>\r\n    <form @submit.prevent=\"loginUser\">\r\n      <div>\r\n        <label for=\"email\">Email:</label>\r\n        <input type=\"email\" v-model=\"email\" required />\r\n      </div>\r\n      <div>\r\n        <label for=\"password\">Password:</label>\r\n        <input type=\"password\" v-model=\"password\" required />\r\n      </div>\r\n      <button type=\"submit\">Login</button>\r\n    </form>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from \"axios\";\r\n\r\nexport default {\r\n  name: \"UserLogin\",\r\n  data() {\r\n    return {\r\n      email: \"\",\r\n      password: \"\"\r\n    };\r\n  },\r\n  methods: {\r\n    async loginUser() {\r\n      try {\r\n        const response = await axios.post(\"http://localhost:3000/login\", {\r\n          email: this.email,\r\n          password: this.password\r\n        });\r\n        \r\n        if (response.data.success) {\r\n          // Successful login, redirect to homepage\r\n          alert(\"Login successful! Redirecting to homepage...\");\r\n          this.$router.push(\"/homepage\");\r\n        } else if (response.data.message === \"User not found\") {\r\n          alert(\"User not found. Please register first.\");\r\n          this.$router.push(\"/register\");\r\n        } else {\r\n          alert(\"Invalid credentials, please try again.\");\r\n        }\r\n      } catch (error) {\r\n        alert(\"An error occurred. Please try again later.\");\r\n        console.error(error);\r\n      }\r\n    }\r\n  }\r\n};\r\n</script>\r\n<style scoped>\r\nh1 {\r\n  color: #2c3e50;\r\n}\r\n</style>\r\n"],"mappings":";AAkBA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE;IACZ,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,SAASA,CAAA,EAAG;MAChB,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMP,KAAK,CAACQ,IAAI,CAAC,6BAA6B,EAAE;UAC/DL,KAAK,EAAE,IAAI,CAACA,KAAK;UACjBC,QAAQ,EAAE,IAAI,CAACA;QACjB,CAAC,CAAC;QAEF,IAAIG,QAAQ,CAACL,IAAI,CAACO,OAAO,EAAE;UACzB;UACAC,KAAK,CAAC,8CAA8C,CAAC;UACrD,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,WAAW,CAAC;QAChC,OAAO,IAAIL,QAAQ,CAACL,IAAI,CAACW,OAAM,KAAM,gBAAgB,EAAE;UACrDH,KAAK,CAAC,wCAAwC,CAAC;UAC/C,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,WAAW,CAAC;QAChC,OAAO;UACLF,KAAK,CAAC,wCAAwC,CAAC;QACjD;MACF,EAAE,OAAOI,KAAK,EAAE;QACdJ,KAAK,CAAC,4CAA4C,CAAC;QACnDK,OAAO,CAACD,KAAK,CAACA,KAAK,CAAC;MACtB;IACF;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}