st:3000/login', {\r\n          email: this.email,\r\n          password: this.password,\r\n        });\r\n\r\n        if (response.data.success) {\r\n          this.successMessage = response.data.message;\r\n          this.errorMessage = '';\r\n          // Redirect to Home page\r\n          this.$router.push('/home');\r\n        } else {\r\n          this.errorMessage = response.data.message;\r\n          this.successMessage = '';\r\n        }\r\n      } catch (error) {\r\n        this.errorMessage = \"An error occurred. Please try again.\";\r\n        this.successMessage = '';\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\nh1 {\r\n  color: #2c3e50;\r\n}\r\n</style>\r\n"],"mappings":";AAkBA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,YAAY,EAAE,EAAE;MAChBC,cAAc,EAAE;IAClB,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,KAAKA,CAAA,EAAG;MACZ,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMR,KAAK,CAACS,IAAI,CAAC,6BAA6B,EAAE;UAC/DP,KAAK,EAAE,IAAI,CAACA,KAAK;UACjBC,QAAQ,EAAE,IAAI,CAACA;QACjB,CAAC,CAAC;QAEF,IAAIK,QAAQ,CAACP,IAAI,CAACS,OAAO,EAAE;UACzB,IAAI,CAACL,cAAa,GAAIG,QAAQ,CAACP,IAAI,CAACU,OAAO;UAC3C,IAAI,CAACP,YAAW,GAAI,EAAE;UACtB;UACA,IAAI,CAACQ,OAAO,CAACC,IAAI,CAAC,OAAO,CAAC;QAC5B,OAAO;UACL,IAAI,CAACT,YAAW,GAAII,QAAQ,CAACP,IAAI,CAACU,OAAO;UACzC,IAAI,CAACN,cAAa,GAAI,EAAE;QAC1B;MACF,EAAE,OAAOS,KAAK,EAAE;QACd,IAAI,CAACV,YAAW,GAAI,sCAAsC;QAC1D,IAAI,CAACC,cAAa,GAAI,EAAE;MAC1B;IACF;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}