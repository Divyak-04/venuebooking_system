{"ast":null,"code":"export default {\n  name: 'DashboardPage',\n  data() {\n    return {\n      bookings: [] // Initialize with an empty array\n    };\n  },\n  methods: {\n    fetchBookings() {\n      // Fetch bookings from local storage\n      let storedBookings = JSON.parse(localStorage.getItem('bookings')) || [];\n      this.bookings = storedBookings;\n    }\n  },\n  mounted() {\n    this.fetchBookings(); // Call fetchBookings when the component mounts\n  }\n};","map":{"version":3,"names":["name","data","bookings","methods","fetchBookings","storedBookings","JSON","parse","localStorage","getItem","mounted"],"sources":["C:\\Users\\divya\\venue-booking\\src\\components\\DashboardPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"dashboard\">\r\n    <h1>Faculty Dashboard - Your Bookings</h1>\r\n    \r\n    <div v-if=\"bookings.length\">\r\n      <h2>Your Booking Details</h2>\r\n      <table>\r\n        <thead>\r\n          <tr>\r\n            <th>Venue</th>\r\n            <th>Date</th>\r\n            <th>Status</th>\r\n            <th>Remark (If Rejected)</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"booking in bookings\" :key=\"booking.date + booking.time\">\r\n            <td>{{ booking.venue }}</td>\r\n            <td>{{ booking.date }}</td>\r\n            <td>{{ booking.status || 'Pending' }}</td>\r\n            <td v-if=\"booking.status === 'Rejected'\">{{ booking.remark || 'No remark' }}</td>\r\n            <td v-else>N/A</td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n    \r\n    <div v-else>\r\n      <p>No bookings found.</p>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'DashboardPage',\r\n  data() {\r\n    return {\r\n      bookings: [] // Initialize with an empty array\r\n    };\r\n  },\r\n  methods: {\r\n    fetchBookings() {\r\n      // Fetch bookings from local storage\r\n      let storedBookings = JSON.parse(localStorage.getItem('bookings')) || [];\r\n      this.bookings = storedBookings;\r\n    }\r\n  },\r\n  mounted() {\r\n    this.fetchBookings(); // Call fetchBookings when the component mounts\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.dashboard {\r\n  padding: 20px;\r\n}\r\ntable {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n}\r\ntable, th, td {\r\n  border: 1px solid #ccc;\r\n}\r\nth, td {\r\n  padding: 10px;\r\n  text-align: left;\r\n}\r\n</style>\r\n"],"mappings":"AAkCA,eAAe;EACbA,IAAI,EAAE,eAAe;EACrBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAC,CAAE;IACf,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACPC,aAAaA,CAAA,EAAG;MACd;MACA,IAAIC,cAAa,GAAIC,IAAI,CAACC,KAAK,CAACC,YAAY,CAACC,OAAO,CAAC,UAAU,CAAC,KAAK,EAAE;MACvE,IAAI,CAACP,QAAO,GAAIG,cAAc;IAChC;EACF,CAAC;EACDK,OAAOA,CAAA,EAAG;IACR,IAAI,CAACN,aAAa,CAAC,CAAC,EAAE;EACxB;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}