{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from \"axios\";\nimport { useRouter } from \"vue-router\";\nexport default {\n  name: \"UserRegister\",\n  data() {\n    return {\n      username: \"\",\n      email: \"\",\n      password: \"\",\n      role: \"\" // Add role to data\n    };\n  },\n  setup() {\n    const router = useRouter();\n    return {\n      router\n    };\n  },\n  methods: {\n    async registerUser() {\n      try {\n        const response = await axios.post(\"http://localhost:3000/register\", {\n          username: this.username,\n          email: this.email,\n          password: this.password,\n          role: this.role // Include role in the request\n        });\n        alert(response.data.message); // Changed alert message\n        this.router.push(\"/login\"); // Redirect to login page\n      } catch (error) {\n        console.error(\"Error registering user:\", error);\n        alert(\"Registration failed. Please try again.\");\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","useRouter","name","data","username","email","password","role","setup","router","methods","registerUser","response","post","alert","message","push","error","console"],"sources":["C:\\Users\\divya\\venue-booking\\src\\components\\UserRegister.vue"],"sourcesContent":["<template>\r\n  <div class=\"register-container\">\r\n    <h2>Register</h2>\r\n    <img src=\"https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTD2EGfn4DS37kbZcHBtpfBHlcwVY7Xbnb90w&s\" alt=\"College Logo\" class=\"logo\" />\r\n    <form @submit.prevent=\"registerUser\">\r\n      <input v-model=\"username\" type=\"text\" placeholder=\"Username\" required />\r\n      <input v-model=\"email\" type=\"email\" placeholder=\"Email\" required />\r\n      <input v-model=\"password\" type=\"password\" placeholder=\"Password\" required />\r\n      \r\n      <div class=\"role-container\">\r\n        <label>\r\n          <input type=\"radio\" v-model=\"role\" value=\"faculty\" required /> Faculty\r\n        </label>\r\n        <label>\r\n          <input type=\"radio\" v-model=\"role\" value=\"admin\" required /> Admin\r\n        </label>\r\n      </div>\r\n\r\n      <button type=\"submit\">Register</button>\r\n    </form>\r\n    <p>Already have an account? <router-link to=\"/login\">Login here</router-link></p>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from \"axios\";\r\nimport { useRouter } from \"vue-router\";\r\n\r\nexport default {\r\n  name: \"UserRegister\",\r\n  data() {\r\n    return {\r\n      username: \"\",\r\n      email: \"\",\r\n      password: \"\",\r\n      role: \"\", // Add role to data\r\n    };\r\n  },\r\n  setup() {\r\n    const router = useRouter();\r\n    return { router };\r\n  },\r\n  methods: {\r\n    async registerUser() {\r\n      try {\r\n        const response = await axios.post(\"http://localhost:3000/register\", {\r\n          username: this.username,\r\n          email: this.email,\r\n          password: this.password,\r\n          role: this.role, // Include role in the request\r\n        });\r\n        alert(response.data.message); // Changed alert message\r\n        this.router.push(\"/login\"); // Redirect to login page\r\n      } catch (error) {\r\n        console.error(\"Error registering user:\", error);\r\n        alert(\"Registration failed. Please try again.\");\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n\r\n<style>\r\n.register-container {\r\n  max-width: 400px;\r\n  margin: auto;\r\n  padding: 20px;\r\n  background-color: #f9f9f9;\r\n  border-radius: 8px;\r\n  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);\r\n  font-family: 'Arial', sans-serif;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.register-container:hover {\r\n  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);\r\n}\r\n\r\nh2 {\r\n  text-align: center;\r\n  margin-bottom: 20px;\r\n  color: #3498db;\r\n}\r\n\r\ninput {\r\n  padding: 12px;\r\n  margin-bottom: 20px;\r\n  border-radius: 4px;\r\n  border: 1px solid #ddd;\r\n  font-size: 14px;\r\n  transition: border-color 0.3s;\r\n}\r\n\r\ninput:focus {\r\n  border-color: #3498db;\r\n  outline: none;\r\n}\r\n.logo{\r\n  width: 150px;\r\n  height: 100px;\r\n}\r\n\r\nbutton {\r\n  padding: 12px;\r\n  border: none;\r\n  background-color: #3498db;\r\n  color: #fff;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n  font-size: 16px;\r\n  transition: background-color 0.3s;\r\n}\r\n\r\nbutton:hover {\r\n  background-color: #2980b9;\r\n}\r\n\r\np {\r\n  text-align: center;\r\n  font-size: 14px;\r\n}\r\n\r\n</style> "],"mappings":";AAyBA,OAAOA,KAAI,MAAO,OAAO;AACzB,SAASC,SAAQ,QAAS,YAAY;AAEtC,eAAe;EACbC,IAAI,EAAE,cAAc;EACpBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,IAAI,EAAE,EAAE,CAAE;IACZ,CAAC;EACH,CAAC;EACDC,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIR,SAAS,CAAC,CAAC;IAC1B,OAAO;MAAEQ;IAAO,CAAC;EACnB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,YAAYA,CAAA,EAAG;MACnB,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMZ,KAAK,CAACa,IAAI,CAAC,gCAAgC,EAAE;UAClET,QAAQ,EAAE,IAAI,CAACA,QAAQ;UACvBC,KAAK,EAAE,IAAI,CAACA,KAAK;UACjBC,QAAQ,EAAE,IAAI,CAACA,QAAQ;UACvBC,IAAI,EAAE,IAAI,CAACA,IAAI,CAAE;QACnB,CAAC,CAAC;QACFO,KAAK,CAACF,QAAQ,CAACT,IAAI,CAACY,OAAO,CAAC,EAAE;QAC9B,IAAI,CAACN,MAAM,CAACO,IAAI,CAAC,QAAQ,CAAC,EAAE;MAC9B,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,yBAAyB,EAAEA,KAAK,CAAC;QAC/CH,KAAK,CAAC,wCAAwC,CAAC;MACjD;IACF;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}