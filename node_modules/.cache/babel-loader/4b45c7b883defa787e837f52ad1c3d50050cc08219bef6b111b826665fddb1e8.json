{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  data() {\n    return {\n      email: '',\n      password: '',\n      errorMessage: '',\n      successMessage: ''\n    };\n  },\n  methods: {\n    async login() {\n      try {\n        console.log('Login clicked. Email:', this.email, 'Password:', this.password);\n\n        // Send login data to backend\n        const response = await axios.post('http://localhost:3000/login', {\n          email: this.email,\n          password: this.password\n        });\n        console.log('Response received:', response.data);\n\n        // Check the response\n        if (response.data.success) {\n          this.successMessage = response.data.message;\n          this.errorMessage = '';\n          // Redirect to Home page after successful login\n          this.$router.push('/home');\n        } else {\n          this.errorMessage = response.data.message;\n          this.successMessage = '';\n        }\n      } catch (error) {\n        console.error('Error occurred during login:', error);\n        this.errorMessage = \"An error occurred. Please try again.\";\n        this.successMessage = '';\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","data","email","password","errorMessage","successMessage","methods","login","console","log","response","post","success","message","$router","push","error"],"sources":["C:\\Users\\divya\\venue-booking\\src\\components\\UserLogin.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <h2>Login</h2>\r\n    <form @submit.prevent=\"login\">\r\n      <div>\r\n        <label for=\"email\">Email:</label>\r\n        <input type=\"email\" v-model=\"email\" required />\r\n      </div>\r\n      <div>\r\n        <label for=\"password\">Password:</label>\r\n        <input type=\"password\" v-model=\"password\" required />\r\n      </div>\r\n      <button type=\"submit\">Login</button>\r\n    </form>\r\n    <p v-if=\"errorMessage\" style=\"color: red;\">{{ errorMessage }}</p>\r\n    <p v-if=\"successMessage\" style=\"color: green;\">{{ successMessage }}</p>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      email: '',\r\n      password: '',\r\n      errorMessage: '',\r\n      successMessage: '',\r\n    };\r\n  },\r\n  methods: {\r\n    async login() {\r\n      try {\r\n        console.log('Login clicked. Email:', this.email, 'Password:', this.password);\r\n\r\n        // Send login data to backend\r\n        const response = await axios.post('http://localhost:3000/login', {\r\n          email: this.email,\r\n          password: this.password,\r\n        });\r\n\r\n        console.log('Response received:', response.data);\r\n\r\n        // Check the response\r\n        if (response.data.success) {\r\n          this.successMessage = response.data.message;\r\n          this.errorMessage = '';\r\n          // Redirect to Home page after successful login\r\n          this.$router.push('/home');\r\n        } else {\r\n          this.errorMessage = response.data.message;\r\n          this.successMessage = '';\r\n        }\r\n      } catch (error) {\r\n        console.error('Error occurred during login:', error);\r\n        this.errorMessage = \"An error occurred. Please try again.\";\r\n        this.successMessage = '';\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n\r\n<style scoped>\r\nh1 {\r\n  color: #2c3e50;\r\n}\r\n</style>\r\n"],"mappings":";AAoBA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,YAAY,EAAE,EAAE;MAChBC,cAAc,EAAE;IAClB,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,KAAKA,CAAA,EAAG;MACZ,IAAI;QACFC,OAAO,CAACC,GAAG,CAAC,uBAAuB,EAAE,IAAI,CAACP,KAAK,EAAE,WAAW,EAAE,IAAI,CAACC,QAAQ,CAAC;;QAE5E;QACA,MAAMO,QAAO,GAAI,MAAMV,KAAK,CAACW,IAAI,CAAC,6BAA6B,EAAE;UAC/DT,KAAK,EAAE,IAAI,CAACA,KAAK;UACjBC,QAAQ,EAAE,IAAI,CAACA;QACjB,CAAC,CAAC;QAEFK,OAAO,CAACC,G