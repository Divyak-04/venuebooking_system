{"ast":null,"code":"import axios from 'axios';\nimport eventBus from '@/eventBus';\nexport default {\n  name: 'AdminDashboardPage',\n  data() {\n    return {\n      bookings: [] // List of all bookings\n    };\n  },\n  methods: {\n    // Fetch the list of bookings from the server\n    async fetchBookings() {\n      try {\n        const response = await axios.get('http://localhost:3002/bookings');\n        this.bookings = response.data; // Ensure the response includes the `remark`\n      } catch (error) {\n        console.error('Error fetching bookings:', error);\n      }\n    },\n    // Approve a booking and update the status locally and on the server\n    async approveBooking(booking) {\n      try {\n        const response = await axios.patch(`http://localhost:3002/bookings/${booking._id}`, {\n          status: 'Approved'\n        });\n        booking.status = 'Approved'; // Update local status to reflect the change\n        eventBus.emit('booking-updated'); // Emit event to notify other components\n      } catch (error) {\n        console.error('Error approving booking:', error);\n      }\n    },\n    // Prompt the user to provide a remark before rejecting a booking\n    promptReject(booking) {\n      const userRemark = prompt('Please enter a remark for rejection:');\n      if (userRemark) {\n        this.rejectBooking(booking, userRemark); // Pass the remark to the reject method\n      }\n    },\n    // Reject a booking and update the status and remark locally and on the server\n    async rejectBooking(booking, remark) {\n      try {\n        const response = await axios.patch(`http://localhost:3002/bookings/${booking._id}`, {\n          status: 'Rejected',\n          remark\n        });\n        booking.status = 'Rejected'; // Update local status to reflect the change\n        booking.remark = remark; // Store the remark\n        eventBus.emit('booking-updated'); // Emit event to notify other components\n      } catch (error) {\n        console.error('Error rejecting booking:', error);\n      }\n    }\n  },\n  mounted() {\n    // Fetch the bookings when the component is mounted\n    this.fetchBookings();\n  }\n};","map":{"version":3,"names":["axios","eventBus","name","data","bookings","methods","fetchBookings","response","get","error","console","approveBooking","booking","patch","_id","status","emit","promptReject","userRemark","prompt","rejectBooking","remark","mounted"],"sources":["C:\\Users\\divya\\venue-booking\\src\\components\\AdminDashboardPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"admin-dashboard\">\r\n    <h1>Admin Dashboard - Manage Bookings</h1>\r\n\r\n    <div v-if=\"bookings.length\">\r\n      <h2>Booking Details</h2>\r\n      <table>\r\n        <thead>\r\n          <tr>\r\n            <th>Venue</th>\r\n            <th>Date</th>\r\n            <th>Time</th>\r\n            <th>Purpose</th>\r\n            <th>Status</th>\r\n            <th>Action</th>\r\n            <th>Remark</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"booking in bookings\" :key=\"booking._id\">\r\n            <td>{{ booking.venue }}</td>\r\n            <td>{{ booking.date }}</td>\r\n            <td>{{ booking.time }}</td>\r\n            <td>{{ booking.purpose }}</td>\r\n            <td>\r\n              <span v-if=\"booking.status === 'Approved'\" class=\"approved-status\">\r\n                ✔️ Approved\r\n              </span>\r\n              <span v-else-if=\"booking.status === 'Rejected'\" class=\"rejected-status\">\r\n                ❌ Rejected\r\n              </span>\r\n              <span v-else>\r\n                Pending\r\n              </span>\r\n            </td>\r\n            <td class=\"action-buttons\">\r\n              <button v-if=\"booking.status === 'Pending'\" @click=\"approveBooking(booking)\" class=\"approve-button\">\r\n                Approve\r\n              </button>\r\n              <button v-if=\"booking.status === 'Pending'\" @click=\"promptReject(booking)\" class=\"reject-button\">\r\n                Reject\r\n              </button>\r\n            </td>\r\n            <td>\r\n              <span v-if=\"booking.status === 'Rejected'\">{{ booking.remark }}</span> <!-- Display saved remark -->\r\n            </td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n\r\n    <div v-else>\r\n      <p>No bookings found.</p>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\nimport eventBus from '@/eventBus';\r\n\r\nexport default {\r\n  name: 'AdminDashboardPage',\r\n  data() {\r\n    return {\r\n      bookings: [], // List of all bookings\r\n    };\r\n  },\r\n  methods: {\r\n    // Fetch the list of bookings from the server\r\n    async fetchBookings() {\r\n      try {\r\n        const response = await axios.get('http://localhost:3002/bookings');\r\n        this.bookings = response.data; // Ensure the response includes the `remark`\r\n      } catch (error) {\r\n        console.error('Error fetching bookings:', error);\r\n      }\r\n    },\r\n\r\n    // Approve a booking and update the status locally and on the server\r\n    async approveBooking(booking) {\r\n      try {\r\n        const response = await axios.patch(`http://localhost:3002/bookings/${booking._id}`, { status: 'Approved' });\r\n        booking.status = 'Approved'; // Update local status to reflect the change\r\n        eventBus.emit('booking-updated'); // Emit event to notify other components\r\n      } catch (error) {\r\n        console.error('Error approving booking:', error);\r\n      }\r\n    },\r\n\r\n    // Prompt the user to provide a remark before rejecting a booking\r\n    promptReject(booking) {\r\n      const userRemark = prompt('Please enter a remark for rejection:');\r\n      if (userRemark) {\r\n        this.rejectBooking(booking, userRemark); // Pass the remark to the reject method\r\n      }\r\n    },\r\n\r\n    // Reject a booking and update the status and remark locally and on the server\r\n    async rejectBooking(booking, remark) {\r\n      try {\r\n        const response = await axios.patch(`http://localhost:3002/bookings/${booking._id}`, { status: 'Rejected', remark });\r\n        booking.status = 'Rejected'; // Update local status to reflect the change\r\n        booking.remark = remark; // Store the remark\r\n        eventBus.emit('booking-updated'); // Emit event to notify other components\r\n      } catch (error) {\r\n        console.error('Error rejecting booking:', error);\r\n      }\r\n    },\r\n  },\r\n  mounted() {\r\n    // Fetch the bookings when the component is mounted\r\n    this.fetchBookings();\r\n  },\r\n};\r\n</script>\r\n\r\n\r\n<style scoped>\r\n.admin-dashboard {\r\n  padding: 20px;\r\n}\r\n\r\ntable {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n}\r\n\r\ntable,\r\nth,\r\ntd {\r\n  border: 1px solid #ccc;\r\n}\r\n\r\nth,\r\ntd {\r\n  padding: 10px;\r\n  text-align: left;\r\n}\r\n\r\n.action-buttons {\r\n  display: flex;\r\n  gap: 10px;\r\n}\r\n\r\n.approve-button,\r\n.reject-button {\r\n  padding: 8px 12px;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n  color: #fff;\r\n  font-weight: bold;\r\n  transition: background-color 0.3s;\r\n}\r\n\r\n.approve-button {\r\n  background-color: #4caf50;\r\n}\r\n\r\n.approve-button:hover {\r\n  background-color: #45a049;\r\n}\r\n\r\n.reject-button {\r\n  background-color: #f44336;\r\n}\r\n\r\n.reject-button:hover {\r\n  background-color: #d32f2f;\r\n}\r\n\r\n.approved-status {\r\n  color: green;\r\n  font-weight: bold;\r\n}\r\n\r\n.rejected-status {\r\n  color: red;\r\n  font-weight: bold;\r\n}\r\n</style>\r\n"],"mappings":"AA0DA,OAAOA,KAAI,MAAO,OAAO;AACzB,OAAOC,QAAO,MAAO,YAAY;AAEjC,eAAe;EACbC,IAAI,EAAE,oBAAoB;EAC1BC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE,CAAE;IAChB,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP;IACA,MAAMC,aAAaA,CAAA,EAAG;MACpB,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMP,KAAK,CAACQ,GAAG,CAAC,gCAAgC,CAAC;QAClE,IAAI,CAACJ,QAAO,GAAIG,QAAQ,CAACJ,IAAI