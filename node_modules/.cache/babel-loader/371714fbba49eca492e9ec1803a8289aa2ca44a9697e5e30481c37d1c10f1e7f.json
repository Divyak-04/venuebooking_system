{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  name: 'DashboardPage',\n  data() {\n    return {\n      bookings: [],\n      role: '' // Initialize role\n    };\n  },\n  methods: {\n    async fetchBookings() {\n      const userEmail = localStorage.getItem('userEmail');\n      const userRole = localStorage.getItem('userRole');\n      this.role = userRole;\n      if (!userEmail) {\n        alert('No user email found. Please log in again.');\n        this.$router.push('/login');\n        return;\n      }\n      try {\n        // Fetch based on role\n        const response = await axios.get(`http://localhost:3002/bookings/${userRole}/${userEmail}`);\n        this.bookings = response.data;\n      } catch (error) {\n        console.error('Error fetching bookings:', error);\n        alert('Failed to fetch bookings. Please try again later.');\n      }\n    }\n  },\n  created() {\n    this.fetchBookings();\n  }\n};","map":{"version":3,"names":["axios","name","data","bookings","role","methods","fetchBookings","userEmail","localStorage","getItem","userRole","alert","$router","push","response","get","error","console","created"],"sources":["C:\\Users\\divya\\venue-booking\\src\\components\\DashboardPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"dashboard\">\r\n    <h1>{{ role === 'faculty' ? 'Faculty Dashboard' : 'Admin Dashboard' }} - Your Bookings</h1>\r\n    \r\n    <div v-if=\"bookings.length\">\r\n      <h2>Your Booking Details</h2>\r\n      <table>\r\n        <thead>\r\n          <tr>\r\n            <th>Venue</th>\r\n            <th>Date</th>\r\n            <th>Status</th>\r\n            <th>Remark (If Rejected)</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"booking in bookings\" :key=\"booking._id\">\r\n            <td>{{ booking.venue }}</td>\r\n            <td>{{ booking.date }}</td>\r\n            <td>{{ booking.status }}</td>\r\n            <td v-if=\"booking.status === 'Rejected'\">{{ booking.remark }}</td>\r\n            <td v-else>N/A</td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n    \r\n    <div v-else>\r\n      <p>No bookings found.</p>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'DashboardPage',\r\n  data() {\r\n    return {\r\n      bookings: [],\r\n      role: '' // Initialize role\r\n    };\r\n  },\r\n  methods: {\r\n    async fetchBookings() {\r\n      const userEmail = localStorage.getItem('userEmail');\r\n      const userRole = localStorage.getItem('userRole');\r\n      this.role = userRole;\r\n\r\n      if (!userEmail) {\r\n        alert('No user email found. Please log in again.');\r\n        this.$router.push('/login');\r\n        return;\r\n      }\r\n\r\n      try {\r\n        // Fetch based on role\r\n        const response = await axios.get(`http://localhost:3002/bookings/${userRole}/${userEmail}`);\r\n        this.bookings = response.data;\r\n      } catch (error) {\r\n        console.error('Error fetching bookings:', error);\r\n        alert('Failed to fetch bookings. Please try again later.');\r\n      }\r\n    }\r\n  },\r\n  created() {\r\n    this.fetchBookings();\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.dashboard {\r\n  padding: 20px;\r\n}\r\ntable {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n}\r\ntable, th, td {\r\n  border: 1px solid #ccc;\r\n}\r\nth, td {\r\n  padding: 10px;\r\n  text-align: left;\r\n}\r\n</style>\r\n"],"mappings":";AAkCA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,eAAe;EACrBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,IAAI,EAAE,EAAC,CAAE;IACX,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,aAAaA,CAAA,EAAG;MACpB,MAAMC,SAAQ,GAAIC,YAAY,CAACC,OAAO,CAAC,WAAW,CAAC;MACnD,MAAMC,QAAO,GAAIF,YAAY,CAACC,OAAO,CAAC,UAAU,CAAC;MACjD,IAAI,CAACL,IAAG,GAAIM,QAAQ;MAEpB,IAAI,CAACH,SAAS,EAAE;QACdI,KAAK,CAAC,2CAA2C,CAAC;QAClD,IAAI,CAACC,OAAO,CAACC,IAAI