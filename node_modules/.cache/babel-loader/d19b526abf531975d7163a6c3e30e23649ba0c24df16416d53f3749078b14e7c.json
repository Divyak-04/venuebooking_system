{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  data() {\n    return {\n      email: '',\n      password: '',\n      role: '',\n      errorMessage: '',\n      successMessage: ''\n    };\n  },\n  methods: {\n    async login() {\n      try {\n        const response = await axios.post('http://localhost:3000/login', {\n          email: this.email,\n          password: this.password,\n          role: this.role\n        });\n        if (response.data.success) {\n          this.successMessage = response.data.message;\n          this.errorMessage = '';\n          this.$router.push('/'); // Redirect to home page\n        } else {\n          this.errorMessage = response.data.message;\n          this.successMessage = '';\n        }\n      } catch (error) {\n        this.errorMessage = 'An error occurred. Please try again.';\n        this.successMessage = '';\n        console.error('Error during login:', error);\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","data","email","password","role","errorMessage","successMessage","methods","login","response","post","success","message","$router","push","error","console"],"sources":["C:\\Users\\divya\\venue-booking\\src\\components\\UserLogin.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <h2>Login</h2>\r\n    <form @submit.prevent=\"login\">\r\n      <div>\r\n        <label for=\"role\">Role:</label>\r\n        <select v-model=\"role\" required>\r\n          <option value=\"\" disabled>Select Role</option>\r\n          <option value=\"faculty\">Faculty</option>\r\n          <option value=\"admin\">Admin</option>\r\n        </select>\r\n      </div>\r\n      <div>\r\n        <label for=\"email\">Email:</label>\r\n        <input type=\"email\" v-model=\"email\" required />\r\n      </div>\r\n      <div>\r\n        <label for=\"password\">Password:</label>\r\n        <input type=\"password\" v-model=\"password\" required />\r\n      </div>\r\n      <button type=\"submit\">Login</button>\r\n    </form>\r\n\r\n    <!-- Show error message if login fails -->\r\n    <p v-if=\"errorMessage\" style=\"color: red;\">{{ errorMessage }}</p>\r\n\r\n    <!-- Show success message -->\r\n    <p v-if=\"successMessage\" style=\"color: green;\">{{ successMessage }}</p>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      email: '',\r\n      password: '',\r\n      role: '',\r\n      errorMessage: '',\r\n      successMessage: '',\r\n    };\r\n  },\r\n  methods: {\r\n    async login() {\r\n      try {\r\n        const response = await axios.post('http://localhost:3000/login', {\r\n          email: this.email,\r\n          password: this.password,\r\n          role: this.role,\r\n        });\r\n\r\n        if (response.data.success) {\r\n          this.successMessage = response.data.message;\r\n          this.errorMessage = '';\r\n          this.$router.push('/'); // Redirect to home page\r\n        } else {\r\n          this.errorMessage = response.data.message;\r\n          this.successMessage = '';\r\n        }\r\n      } catch (error) {\r\n        this.errorMessage = 'An error occurred. Please try again.';\r\n        this.successMessage = '';\r\n        console.error('Error during login:', error);\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n<style"],"mappings":";AAgCA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,IAAI,EAAE,EAAE;MACRC,YAAY,EAAE,EAAE;MAChBC,cAAc,EAAE;IAClB,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,KAAKA,CAAA,EAAG;MACZ,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMT,KAAK,CAACU,IAAI,CAAC,6BAA6B,EAAE;UAC/DR,KAAK,EAAE,IAAI,CAACA,KAAK;UACjBC,QAAQ,EAAE,IAAI,CAACA,QAAQ;UACvBC,IAAI,EAAE,IAAI,CAACA;QACb,CAAC,CAAC;QAEF,IAAIK,QAAQ,CAACR,IAAI,CAACU,OAAO,EAAE;UACzB,IAAI,CAACL,cAAa,GAAIG,QAAQ,CAACR,IAAI,CAACW,OAAO;UAC3C,IAAI,CAACP,YAAW,GAAI,EAAE;UACtB,IAAI,CAACQ,OAAO,CAACC,IAAI,CAAC,GAAG,CAAC,