{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  data() {\n    return {\n      email: '',\n      password: '',\n      errorMessage: '',\n      // To display error message\n      successMessage: '' // To display success message\n    };\n  },\n  methods: {\n    async login() {\n      try {\n        // Make the login request to the backend\n        const response = await axios.post('http://localhost:3000/login', {\n          email: this.email,\n          password: this.password\n        });\n\n        // Check the response from the server\n        if (response.data.success) {\n          // If login is successful, show the success message and redirect to home page\n          this.successMessage = response.data.message;\n          this.errorMessage = ''; // Clear the error message\n          this.$router.push('/'); // Redirect to home page\n        } else {\n          // If login fails, show the error message\n          this.errorMessage = response.data.message;\n          this.successMessage = ''; // Clear the success message\n        }\n      } catch (error) {\n        // Handle any unexpected errors\n        this.errorMessage = 'An error occurred. Please try again.';\n        this.successMessage = '';\n        console.error('Error during login:', error);\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","data","email","password","errorMessage","successMessage","methods","login","response","post","success","message","$router","push","error","console"],"sources":["C:\\Users\\divya\\venue-booking\\src\\components\\UserLogin.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <h2>Login</h2>\r\n    <form @submit.prevent=\"login\">\r\n      <div>\r\n        <label for=\"email\">Email:</label>\r\n        <input type=\"email\" v-model=\"email\" required />\r\n      </div>\r\n      <div>\r\n        <label for=\"password\">Password:</label>\r\n        <input type=\"password\" v-model=\"password\" required />\r\n      </div>\r\n      <button type=\"submit\">Login</button>\r\n    </form>\r\n\r\n    <!-- Show error message if login fails -->\r\n    <p v-if=\"errorMessage\" style=\"color: red;\">{{ errorMessage }}</p>\r\n\r\n    <!-- Show success message -->\r\n    <p v-if=\"successMessage\" style=\"color: green;\">{{ successMessage }}</p>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      email: '',\r\n      password: '',\r\n      errorMessage: '', // To display error message\r\n      successMessage: '', // To display success message\r\n    };\r\n  },\r\n  methods: {\r\n    async login() {\r\n      try {\r\n        // Make the login request to the backend\r\n        const response = await axios.post('http://localhost:3000/login', {\r\n          email: this.email,\r\n          password: this.password,\r\n        });\r\n\r\n        // Check the response from the server\r\n        if (response.data.success) {\r\n          // If login is successful, show the success message and redirect to home page\r\n          this.successMessage = response.data.message;\r\n          this.errorMessage = ''; // Clear the error message\r\n          this.$router.push('/'); // Redirect to home page\r\n        } else {\r\n          // If login fails, show the error message\r\n          this.errorMessage = response.data.message;\r\n          this.successMessage = ''; // Clear the success message\r\n        }\r\n      } catch (error) {\r\n        // Handle any unexpected errors\r\n        this.errorMessage = 'An error occurred. Please try again.';\r\n        this.successMessage = '';\r\n        console.error('Error during login:', error);\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n\r\n<style scoped>\r\nh1 {\r\n  color: #2c3e50;\r\n}\r\n</style>\r\n"],"mappings":";AAwBA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,YAAY,EAAE,EAAE;