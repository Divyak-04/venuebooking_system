{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  data() {\n    return {\n      form: {\n        venue: '',\n        date: '',\n        time: '',\n        purpose: '',\n        facultyId: '' // Add facultyId here\n      }\n    };\n  },\n  mounted() {\n    // Example: Set facultyId when the component is loaded (you can replace this with the actual logic for getting the ID)\n    this.form.facultyId = localStorage.getItem('facultyId') || 'FAKE_FACULTY_ID';\n    // You may need to replace 'FAKE_FACULTY_ID' with the actual ID from the authentication or state management logic\n  },\n  methods: {\n    submitBooking() {\n      console.log(this.form); // Log the form data for debugging purposes\n      axios.post('http://localhost:3002/book', this.form).then(response => {\n        // Ensure the response is successful and contains a message\n        if (response.data && response.data.message) {\n          alert(response.data.message); // Show success message\n          this.$router.push(\"/success\"); // Redirect to SuccessPage or DashboardPage\n        } else {\n          throw new Error('Unexpected response format');\n        }\n      }).catch(error => {\n        console.error('There was an error!', error);\n        alert('Booking submission failed. Please try again.');\n      });\n    }\n  }\n};","map":{"version":3,"names":["axios","data","form","venue","date","time","purpose","facultyId","mounted","localStorage","getItem","methods","submitBooking","console","log","post","then","response","message","alert","$router","push","Error","catch","error"],"sources":["C:\\Users\\divya\\venue-booking\\src\\components\\BookingPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"booking-container\">\r\n    <h1>Book a Venue</h1>\r\n    <form @submit.prevent=\"submitBooking\">\r\n      <div class=\"form-group\">\r\n        <label for=\"venue\">Select Venue</label>\r\n        <select v-model=\"form.venue\" required>\r\n          <option value=\"\" disabled>Select a venue</option>\r\n          <option value=\"Seminar Hall 1\">Seminar Hall 1</option>\r\n          <option value=\"Conference Room\">Conference Room</option>\r\n          <option value=\"Main Auditorium\">Main Auditorium</option>\r\n          <option value=\"Vedanayagam Auditorium\">Vedanayagam Auditorium</option>\r\n          <option value=\"Agri Seminar Hall\">Agri Seminar Hall</option>\r\n          <option value=\"ECE Seminar Hall\">ECE Seminar Hall</option>\r\n          <option value=\"EEE Seminar Hall\">EEE Seminar Hall</option>\r\n          <option value=\"Biotech Seminar Hall\">Biotech Seminar Hall</option>\r\n          <option value=\"Textile Seminar Hall\">Textile Seminar Hall</option>\r\n        </select>\r\n      </div>\r\n\r\n      <div class=\"form-group\">\r\n        <label for=\"date\">Event Date</label>\r\n        <input type=\"date\" v-model=\"form.date\" required />\r\n      </div>\r\n\r\n      <div class=\"form-group\">\r\n        <label for=\"time\">Event Time</label>\r\n        <input type=\"time\" v-model=\"form.time\" required />\r\n      </div>\r\n\r\n      <div class=\"form-group\">\r\n        <label for=\"purpose\">Event Purpose</label>\r\n        <textarea v-model=\"form.purpose\" placeholder=\"Describe the event purpose\" required></textarea>\r\n      </div>\r\n\r\n      <button type=\"submit\" class=\"btn-submit\">Submit Booking</button>\r\n    </form>\r\n  </div>\r\n</template>\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      form: {\r\n        venue: '',\r\n        date: '',\r\n        time: '',\r\n        purpose: '',\r\n        facultyId: '' // Add facultyId here\r\n      }\r\n    };\r\n  },\r\n  mounted() {\r\n    // Example: Set facultyId when the component is loaded (you can replace this with the actual logic for getting the ID)\r\n    this.form.facultyId = localStorage.getItem('facultyId') || 'FAKE_FACULTY_ID'; \r\n    // You may need to replace 'FAKE_FACULTY_ID' with the actual ID from the authentication or state management logic\r\n  },\r\n  methods: {\r\n    submitBooking() {\r\n      console.log(this.form); // Log the form data for debugging purposes\r\n      axios.post('http://localhost:3002/book', this.form)\r\n        .then(response => {\r\n          // Ensure the response is successful and contains a message\r\n          if (response.data && response.data.message) {\r\n            alert(response.data.message); // Show success message\r\n            this.$router.push(\"/success\"); // Redirect to SuccessPage or DashboardPage\r\n          } else {\r\n            throw new Error('Unexpected response format');\r\n          }\r\n        })\r\n        .catch(error => {\r\n          console.error('There was an error!', error);\r\n          alert('Booking submission failed. Please try again.');\r\n        });\r\n    }\r\n  }\r\n}\r\n</script>\r\n"],"mappings":";AAwCA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE;QACJC,KAAK,EAAE,EAAE;QACTC,IAAI,EAAE,EAAE;QACRC,IAAI,EAAE,EAAE;QACRC,OAAO,EAAE,EAAE;QACXC,SAAS,EAAE,EAAC,CAAE;MAChB;IACF,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR;IACA,IAAI,CAACN,IAAI,CAACK,SAAQ,GAAIE,YAAY,CAACC,OAAO,CAAC,WAAW,KAAK,iBAAiB;IAC5E;EACF,CAAC;EACDC,OAAO,EAAE;IACPC,aAAaA,CAAA,EAAG;MACdC,OAAO,CAACC,GAAG,CAAC,IAAI,CAACZ,IAAI,CAAC,EAAE;MACxBF,KAAK,CAACe,IAAI,CAAC,4BAA4B,EAAE,IAAI,CAACb,IAAI,EAC/Cc,IAAI,CAACC,QAAO,IAAK;QAChB;QACA,IAAIA,QAAQ,CAAChB,IAAG,IAAKgB,QAAQ,CAAChB,IAAI,CAACiB,OAAO,EAAE;UAC1CC,KAAK,CAACF,QAAQ,CAAChB,IAAI,CAACiB,OAAO,CAAC,EAAE;UAC9B,IAAI,CAACE,OAAO,CAACC,IAAI,CAAC,UAAU,CAAC,EAAE;QACjC,OAAO;UACL,MAAM,IAAIC,KAAK,CAAC,4BAA4B,CAAC;QAC/C;MACF,CAAC,EACAC,KAAK,CAACC,KAAI,IAAK;QACdX,OAAO,CAACW,KAAK,CAAC,qBAAqB,EAAEA,KAAK,CAAC;QAC3CL,KAAK,CAAC,8CAA8C,CAAC;MACvD,CAAC,CAAC;IACN;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}