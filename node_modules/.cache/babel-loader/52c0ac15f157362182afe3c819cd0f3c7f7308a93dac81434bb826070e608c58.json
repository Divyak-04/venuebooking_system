{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  data() {\n    return {\n      username: '',\n      password: '',\n      role: '',\n      errorMessage: ''\n    };\n  },\n  methods: {\n    async handleLogin() {\n      try {\n        const response = await axios.post('http://localhost:5000/api/login', {\n          username: this.username,\n          password: this.password,\n          role: this.role\n        });\n        if (response.data.success) {\n          localStorage.setItem('token', response.data.token);\n          this.$router.push('/booking');\n        } else {\n          this.errorMessage = response.data.message;\n        }\n      } catch (error) {\n        this.errorMessage = 'An error occurred. Please try again.';\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","data","username","password","role","errorMessage","methods","handleLogin","response","post","success","localStorage","setItem","token","$router","push","message","error"],"sources":["C:\\Users\\divya\\venue-booking\\src\\components\\UserLogin.vue"],"sourcesContent":["<template>\r\n  <div class=\"login-container\">\r\n    <h1>Login</h1>\r\n    <form @submit.prevent=\"handleLogin\">\r\n      <label for=\"role\">Login as:</label>\r\n      <select v-model=\"role\" id=\"role\" required>\r\n        <option value=\"\" disabled>Select Role</option>\r\n        <option value=\"faculty\">Faculty</option>\r\n        <option value=\"admin\">Admin</option>\r\n      </select>\r\n      <label for=\"username\">Username/Email:</label>\r\n      <input type=\"text\" v-model=\"username\" id=\"username\" required />\r\n      <label for=\"password\">Password:</label>\r\n      <input type=\"password\" v-model=\"password\" id=\"password\" required />\r\n      <button type=\"submit\">Login</button>\r\n      <p v-if=\"errorMessage\">{{ errorMessage }}</p>\r\n      <p><router-link to=\"/register\">Don't have an account? Sign up</router-link></p>\r\n    </form>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      username: '',\r\n      password: '',\r\n      role: '',\r\n      errorMessage: ''\r\n    };\r\n  },\r\n  methods: {\r\n    async handleLogin() {\r\n      try {\r\n        const response = await axios.post('http://localhost:5000/api/login', {\r\n          username: this.username,\r\n          password: this.password,\r\n          role: this.role\r\n        });\r\n        if (response.data.success) {\r\n          localStorage.setItem('token', response.data.token);\r\n          this.$router.push('/booking');\r\n        } else {\r\n          this.errorMessage = response.data.message;\r\n        }\r\n      } catch (error) {\r\n        this.errorMessage = 'An error occurred. Please try again.';\r\n      }\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n"],"mappings":";AAsBA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,QAAQ,EAAE,EAAE;MACZC,IAAI,EAAE,EAAE;MACRC,YAAY,EAAE;IAChB,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,WAAWA,CAAA,EAAG;MAClB,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMR,KAAK,CAACS,IAAI,CAAC,iCAAiC,EAAE;UACnEP,QAAQ,EAAE,IAAI,CAACA,QAAQ;UACvBC,QAAQ,EAAE,IAAI,CAACA,QAAQ;UACvBC,IAAI,EAAE,IAAI,CAACA;QACb,CAAC,CAAC;QACF,IAAII,QAAQ,CAACP,IAAI,CAACS,OAAO,EAAE;UACzBC,YAAY,CAACC,OAAO,CAAC,OAAO,EAAEJ,QAAQ,CAACP,IAAI,CAACY,KAAK,CAAC;UAClD,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,UAAU,CAAC;QAC/B,OAAO;UACL,IAAI,CAACV,YAAW,GAAIG,QAAQ,CAACP,IAAI,CAACe,OAAO;QAC3C;MACF,EAAE,OAAOC,KAAK,EAAE;QACd,IAAI,CAACZ,YAAW,GAAI,sCAAsC;MAC5D;IACF;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}