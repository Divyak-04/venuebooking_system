{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'DashboardPage',\n  data() {\n    return {\n      bookings: [],\n      totalBookings: 0,\n      pendingBookings: 0,\n      approvedBookings: 0\n    };\n  },\n  methods: {\n    async fetchBookings() {\n      try {\n        const response = await axios.get(\"http://localhost:3000/bookings\");\n        this.bookings = response.data;\n        this.totalBookings = this.bookings.length;\n        this.pendingBookings = this.bookings.filter(booking => booking.status === 'Pending').length;\n        this.approvedBookings = this.bookings.filter(booking => booking.status === 'Approved').length;\n      } catch (error) {\n        console.error(\"Error fetching bookings:\", error);\n      }\n    },\n    async approveBooking(id) {\n      try {\n        await axios.put(`http://localhost:3000/bookings/${id}`, {\n          status: \"Approved\"\n        });\n        this.fetchBookings(); // Refresh bookings after action\n      } catch (error) {\n        console.error(\"Error approving booking:\", error);\n      }\n    },\n    async rejectBooking(id) {\n      try {\n        await axios.put(`http://localhost:3000/bookings/${id}`, {\n          status: \"Rejected\"\n        });\n        this.fetchBookings(); // Refresh bookings after action\n      } catch (error) {\n        console.error(\"Error rejecting booking:\", error);\n      }\n    }\n  },\n  mounted() {\n    this.fetchBookings();\n  }\n};","map":{"version":3,"names":["axios","name","data","bookings","totalBookings","pendingBookings","approvedBookings","methods","fetchBookings","response","get","length","filter","booking","status","error","console","approveBooking","id","put","rejectBooking","mounted"],"sources":["C:\\Users\\divya\\venue-booking\\src\\components\\DashboardPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"dashboard\">\r\n    <h1>Welcome to the Dashboard</h1>\r\n    \r\n    <div class=\"card-container\">\r\n      <div class=\"card\">\r\n        <h3>Total Bookings</h3>\r\n        <p>{{ totalBookings }}</p>\r\n      </div>\r\n      <div class=\"card\">\r\n        <h3>Pending Approvals</h3>\r\n        <p>{{ pendingBookings }}</p>\r\n      </div>\r\n      <div class=\"card\">\r\n        <h3>Approved Bookings</h3>\r\n        <p>{{ approvedBookings }}</p>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"actions\">\r\n      <button @click=\"fetchBookings\">Refresh Data</button>\r\n    </div>\r\n    \r\n    <div v-if=\"bookings.length\">\r\n      <h2>All Bookings</h2>\r\n      <table>\r\n        <thead>\r\n          <tr>\r\n            <th>Venue</th>\r\n            <th>Date</th>\r\n            <th>Status</th>\r\n            <th>Action</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"booking in bookings\" :key=\"booking._id\">\r\n            <td>{{ booking.venue }}</td>\r\n            <td>{{ booking.date }}</td>\r\n            <td>{{ booking.status }}</td>\r\n            <td>\r\n              <button v-if=\"booking.status === 'Pending'\" @click=\"approveBooking(booking._id)\">Approve</button>\r\n              <button v-if=\"booking.status === 'Pending'\" @click=\"rejectBooking(booking._id)\">Reject</button>\r\n            </td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'DashboardPage',\r\n  data() {\r\n    return {\r\n      bookings: [],\r\n      totalBookings: 0,\r\n      pendingBookings: 0,\r\n      approvedBookings: 0,\r\n    };\r\n  },\r\n  methods: {\r\n    async fetchBookings() {\r\n      try {\r\n        const response = await axios.get(\"http://localhost:3000/bookings\");\r\n        this.bookings = response.data;\r\n        this.totalBookings = this.bookings.length;\r\n        this.pendingBookings = this.bookings.filter(booking => booking.status === 'Pending').length;\r\n        this.approvedBookings = this.bookings.filter(booking => booking.status === 'Approved').length;\r\n      } catch (error) {\r\n        console.error(\"Error fetching bookings:\", error);\r\n      }\r\n    },\r\n    async approveBooking(id) {\r\n      try {\r\n        await axios.put(`http://localhost:3000/bookings/${id}`, { status: \"Approved\" });\r\n        this.fetchBookings(); // Refresh bookings after action\r\n      } catch (error) {\r\n        console.error(\"Error approving booking:\", error);\r\n      }\r\n    },\r\n    async rejectBooking(id) {\r\n      try {\r\n        await axios.put(`http://localhost:3000/bookings/${id}`, { status: \"Rejected\" });\r\n        this.fetchBookings(); // Refresh bookings after action\r\n      } catch (error) {\r\n        console.error(\"Error rejecting booking:\", error);\r\n      }\r\n    }\r\n  },\r\n  mounted() {\r\n    this.fetchBookings();\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.dashboard {\r\n  padding: 20px;\r\n}\r\n.card-container {\r\n  display: flex;\r\n  justify-content: space-around;\r\n  margin-bottom: 20px;\r\n}\r\n.card {\r\n  background: #f9f9f9;\r\n  padding: 20px;\r\n  border-radius: 8px;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\r\n  text-align: center;\r\n}\r\n.actions {\r\n  margin-bottom: 20px;\r\n}\r\ntable {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n}\r\ntable, th, td {\r\n  border: 1px solid #ccc;\r\n}\r\nth, td {\r\n  padding: 10px;\r\n  text-align: left;\r\n}\r\n</style>\r\n"],"mappings":"AAmDA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,eAAe;EACrBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,aAAa,EAAE,CAAC;MAChBC,eAAe,EAAE,CAAC;MAClBC,gBAAgB,EAAE;IACpB,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,aAAaA,CAAA,EAAG;MACpB,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMT,KAAK,CAACU,GAAG,CAAC,gCAAgC,CAAC;QAClE,IAAI,CAACP,QAAO,GAAIM,QAAQ,CAACP,IAAI;QAC7B,IAAI,CAACE,aAAY,GAAI,IAAI,CAACD,QAAQ,CAACQ,MAAM;QACzC,IAAI,CAACN,eAAc,GAAI,IAAI,CAACF,QAAQ,CAACS,MAAM,CAACC,OAAM,IAAKA,OAAO,CAACC,MAAK,KAAM,SAAS,CAAC,CAACH,MAAM;QAC3F,IAAI,CA