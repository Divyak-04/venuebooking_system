{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from \"axios\";\nimport { useRouter } from \"vue-router\";\nexport default {\n  name: \"UserRegister\",\n  data() {\n    return {\n      username: \"\",\n      email: \"\",\n      password: \"\",\n      role: \"\"\n    };\n  },\n  setup() {\n    const router = useRouter();\n    return {\n      router\n    };\n  },\n  methods: {\n    async registerUser() {\n      try {\n        const response = await axios.post(\"http://localhost:3000/register\", {\n          username: this.username,\n          email: this.email,\n          password: this.password,\n          role: this.role\n        });\n        alert(response.data.message);\n        this.router.push(\"/login\");\n      } catch (error) {\n        console.error(\"Error registering user:\", error);\n        alert(\"Registration failed. Please try again.\");\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","useRouter","name","data","username","email","password","role","setup","router","methods","registerUser","response","post","alert","message","push","error","console"],"sources":["C:\\Users\\divya\\venue-booking\\src\\components\\UserRegister.vue"],"sourcesContent":["<template>\r\n  <div class=\"register-container\">\r\n    <h2>Register</h2>\r\n    <img src=\"https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTD2EGfn4DS37kbZcHBtpfBHlcwVY7Xbnb90w&s\" alt=\"College Logo\" class=\"logo\" />\r\n    <form @submit.prevent=\"registerUser\">\r\n      <input v-model=\"username\" type=\"text\" placeholder=\"Username\" required />\r\n      <input v-model=\"email\" type=\"email\" placeholder=\"Email\" required />\r\n      <input v-model=\"password\" type=\"password\" placeholder=\"Password\" required />\r\n      \r\n      <div>\r\n        <label>Role:</label>\r\n        <label>\r\n          <input type=\"radio\" v-model=\"role\" value=\"faculty\" required /> Faculty\r\n        </label>\r\n        <label>\r\n          <input type=\"radio\" v-model=\"role\" value=\"admin\" required /> Admin\r\n        </label>\r\n      </div>\r\n\r\n      <button type=\"submit\">Register</button>\r\n    </form>\r\n    <p>Already have an account? <router-link to=\"/login\">Login here</router-link></p>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from \"axios\";\r\nimport { useRouter } from \"vue-router\";\r\n\r\nexport default {\r\n  name: \"UserRegister\",\r\n  data() {\r\n    return {\r\n      username: \"\",\r\n      email: \"\",\r\n      password: \"\",\r\n      role: \"\",\r\n    };\r\n  },\r\n  setup() {\r\n    const router = useRouter();\r\n    return { router };\r\n  },\r\n  methods: {\r\n    async registerUser() {\r\n      try {\r\n        const response = await axios.post(\"http://localhost:3000/register\", {\r\n          username: this.username,\r\n          email: this.email,\r\n          password: this.password,\r\n          role: this.role,\r\n        });\r\n        alert(response.data.message);\r\n        this.router.push(\"/login\");\r\n      } catch (error) {\r\n        console.error(\"Error registering user:\", error);\r\n        alert(\"Registration failed. Please try again.\");\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style>\r\n/* Your existing styles remain unchanged */\r\n</style>\r\n"],"mappings":";AA0BA,OAAOA,KAAI,MAAO,OAAO;AACzB,SAASC,SAAQ,QAAS,YAAY;AAEtC,eAAe;EACbC,IAAI,EAAE,cAAc;EACpBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,IAAI,EAAE;IACR,CAAC;EACH,CAAC;EACDC,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIR,SAAS,CAAC,CAAC;IAC1B,OAAO;MAAEQ;IAAO,CAAC;EACnB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,YAAYA,CAAA,EAAG;MACnB,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMZ,KAAK,CAACa,IAAI,CAAC,gCAAgC,EAAE;UAClET,QAAQ,EAAE,IAAI,CAACA,QAAQ;UACvBC,KAAK,EAAE,IAAI,CAACA,KAAK;UACjBC,QAAQ,EAAE,IAAI,CAACA,QAAQ;UACvBC,IAAI,EAAE,IAAI,CAACA;QACb,CAAC,CAAC;QACFO,KAAK,CAACF,QAAQ,CAACT,IAAI,CAACY,OAAO,CAAC;QAC5B,IAAI,CAACN,MAAM,CAACO,IAAI,CAAC,QAAQ,CAAC;MAC5B,EAAE,O