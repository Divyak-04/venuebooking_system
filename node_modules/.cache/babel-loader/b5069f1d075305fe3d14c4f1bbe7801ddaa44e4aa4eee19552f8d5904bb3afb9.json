{"ast":null,"code":"import axios from 'axios';\nexport default {\n  data() {\n    return {\n      bookings: []\n    };\n  },\n  mounted() {\n    this.fetchBookings();\n  },\n  methods: {\n    fetchBookings() {\n      const facultyId = this.getFacultyId();\n      axios.get(`http://localhost:3000/bookings/${facultyId}`).then(response => {\n        this.bookings = response.data;\n      }).catch(error => {\n        console.error('Error fetching bookings:', error);\n      });\n    },\n    getFacultyId() {\n      // Get the faculty ID from local storage or Vuex\n      const user = JSON.parse(localStorage.getItem('user'));\n      return user ? user._id : null;\n    }\n  }\n};","map":{"version":3,"names":["axios","data","bookings","mounted","fetchBookings","methods","facultyId","getFacultyId","get","then","response","catch","error","console","user","JSON","parse","localStorage","getItem","_id"],"sources":["C:\\Users\\divya\\venue-booking\\src\\components\\Dashboard.vue"],"sourcesContent":["<template>\r\n    <div class=\"dashboard-container\">\r\n      <h1>Your Bookings</h1>\r\n      <table v-if=\"bookings.length\">\r\n        <thead>\r\n          <tr>\r\n            <th>Venue</th>\r\n            <th>Date</th>\r\n            <th>Time</th>\r\n            <th>Purpose</th>\r\n            <th>Status</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"booking in bookings\" :key=\"booking._id\">\r\n            <td>{{ booking.venue }}</td>\r\n            <td>{{ booking.date }}</td>\r\n            <td>{{ booking.time }}</td>\r\n            <td>{{ booking.purpose }}</td>\r\n            <td>{{ booking.status }}</td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n      <p v-else>No bookings found.</p>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import axios from 'axios';\r\n  \r\n  export default {\r\n    data() {\r\n      return {\r\n        bookings: []\r\n      };\r\n    },\r\n    mounted() {\r\n      this.fetchBookings();\r\n    },\r\n    methods: {\r\n      fetchBookings() {\r\n        const facultyId = this.getFacultyId();\r\n        axios.get(`http://localhost:3000/bookings/${facultyId}`)\r\n          .then(response => {\r\n            this.bookings = response.data;\r\n          })\r\n          .catch(error => {\r\n            console.error('Error fetching bookings:', error);\r\n          });\r\n      },\r\n      getFacultyId() {\r\n        // Get the faculty ID from local storage or Vuex\r\n        const user = JSON.parse(localStorage.getItem('user'));\r\n        return user ? user._id : null;\r\n      }\r\n    }\r\n  }\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .dashboard-container {\r\n    max-width: 800px;\r\n    margin: 0 auto;\r\n    padding: 30px;\r\n    font-family: 'Roboto', sans-serif;\r\n  }\r\n  \r\n  h1 {\r\n    text-align: center;\r\n    margin-bottom: 20px;\r\n    font-size: 2rem;\r\n  }\r\n  \r\n  table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n  }\r\n  \r\n  th, td {\r\n    padding: 12px;\r\n    border: 1px solid #ddd;\r\n    text-align: left;\r\n  }\r\n  \r\n  thead {\r\n    background-color: #f4f4f4;\r\n  }\r\n  \r\n  tbody tr:hover {\r\n    background-color: #f9f9f9;\r\n  }\r\n  </style>\r\n  "],"mappings":"AA4BE,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE;IACZ,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,aAAa,CAAC,CAAC;EACtB,CAAC;EACDC,OAAO,EAAE;IACPD,aAAaA,CAAA,EAAG;MACd,MAAME,SAAQ,GAAI,IAAI,CAACC,YAAY,CAAC,CAAC;MACrCP,KAAK,CAACQ,GAAG,CAAC,kCAAkCF,SAAS,EAAE,EACpDG,IAAI,CAACC,QAAO,IAAK;QAChB,IAAI,CAACR,QAAO,GAAIQ,QAAQ,CAACT,IAAI;MAC/B,CAAC,EACAU,KAAK,CAACC,KAAI,IAAK;QACdC,OAAO,CAACD,KAAK,CAAC,0BAA0B,EAAEA,KAAK,CAAC;MAClD,CAAC,CAAC;IACN,CAAC;IACDL,YAAYA,CAAA,EAAG;MACb;MACA,MAAMO,IAAG,GAAIC,IAAI,CAACC,KAAK,CAACC,YAAY,CAACC,OAAO,CAAC,MAAM,CAAC,CAAC;MACrD,OAAOJ,IAAG,GAAIA,IAAI,CAACK,GAAE,GAAI,IAAI;IAC/B;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}